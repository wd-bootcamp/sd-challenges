# Copy this file to .env and fill in your own values. Never commit .env!

# From your GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# A long random value. Create one with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
BETTER_AUTH_SECRET=a-long-random-value

# The address the browser uses (the Vite page, it forwards /api to this server)
BETTER_AUTH_URL=http://localhost:5173

# NEW: your MongoDB. The part after the last "/" is the database name.
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/github-login-demo
MONGODB_URI=mongodb://127.0.0.1:27017/github-login-demo
