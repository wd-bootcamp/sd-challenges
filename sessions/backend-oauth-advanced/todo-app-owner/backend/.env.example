# Copy this file to .env and fill in your values. Never commit .env.
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/todos?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/todos
MONGODB_URI=mongodb://127.0.0.1:27017/todos
PORT=3001

# The login with GitHub (your own OAuth App: GitHub → Settings → Developer settings → OAuth Apps)
# Callback URL of the OAuth App: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
# A long random value: node -p "require('crypto').randomBytes(32).toString('hex')"
BETTER_AUTH_SECRET=a-long-random-value
# The address the browser uses (the Vite page, it forwards /api to this server)
BETTER_AUTH_URL=http://localhost:5173
