# Copy this file to .env and fill in your values. Never commit .env.
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/reading-list?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/reading-list
MONGODB_URI=mongodb://127.0.0.1:27017/reading-list
PORT=3001

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# The client id is public. The client secret is a secret.
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Signs the session cookie. A secret. Create a value with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=replace-with-a-random-value

# The React app. After the login the backend sends the browser here.
FRONTEND_URL=http://localhost:5173
