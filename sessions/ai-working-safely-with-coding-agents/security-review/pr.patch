+const API_URL = "https://notes.example.com/api/notes";
+export const NOTES_API_KEY = "lab-fake-key-0000-do-not-use";
+
+/** Turns **bold** into <b> and line breaks into <br>. */
+export function renderNote(text: string): string {
+  return text.replace(/\*\*(.+?)\*\*/g, "<b>$1</b>").replace(/\n/g, "<br>");
+}
+
+/** Only admins may delete all notes. */
+export function isAdmin(): boolean {
+  return localStorage.getItem("role") === "admin";
+}
+
+export async function saveNote(text: string): Promise<void> {
+  await fetch(API_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", "X-Api-Key": NOTES_API_KEY },
+    body: JSON.stringify({ text }),
+  });
+}
+
+export async function deleteAllNotes(): Promise<void> {
+  await fetch(API_URL, {
+    method: "DELETE",
+    headers: { "X-Api-Key": NOTES_API_KEY },
+  });
+}
