+import { describe, expect, test } from "vitest";
+import { renderNote } from "./notes";
+
+describe("renderNote", () => {
+  test("turns **text** into bold text", () => {
+    expect(renderNote("a **big** book")).toBe("a <b>big</b> book");
+  });
+
+  test("turns line breaks into <br>", () => {
+    expect(renderNote("one\ntwo")).toBe("one<br>two");
+  });
+
+  test("keeps HTML in a note, so formatting works", () => {
+    expect(renderNote("a <i>great</i> book")).toBe("a <i>great</i> book");
+  });
+});
