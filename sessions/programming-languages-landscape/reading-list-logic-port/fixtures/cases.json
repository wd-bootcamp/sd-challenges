  "filterBooks": [
    {
      "name": "status all and empty query returns every book",
      "status": "all",
      "query": "",
      "expectedIds": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5",
        "b6",
        "b7",
        "b8",
        "b9",
        "b10"
      ]
    },
    {
      "name": "status reading and empty query returns the reading books",
      "status": "reading",
      "query": "",
      "expectedIds": [
        "b4",
        "b7"
      ]
    },
    {
      "name": "status done and empty query returns the done books",
      "status": "done",
      "query": "",
      "expectedIds": [
        "b1",
        "b2",
        "b5",
        "b9",
        "b10"
      ]
    },
    {
      "name": "status want-to-read and empty query",
      "status": "want-to-read",
      "query": "",
      "expectedIds": [
        "b3",
        "b6",
        "b8"
      ]
    },
    {
      "name": "query with only spaces counts as empty (trimmed before the check), status all",
      "status": "all",
      "query": "   ",
      "expectedIds": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5",
        "b6",
        "b7",
        "b8",
        "b9",
        "b10"
      ]
    },
    {
      "name": "query with only spaces counts as empty, status done",
      "status": "done",
      "query": "     ",
      "expectedIds": [
        "b1",
        "b2",
        "b5",
        "b9",
        "b10"
      ]
    },
    {
      "name": "query with only a tab and a newline counts as empty",
      "status": "all",
      "query": "\t\n",
      "expectedIds": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5",
        "b6",
        "b7",
        "b8",
        "b9",
        "b10"
      ]
    },
    {
      "name": "lower case query finds a title with upper case letters",
      "status": "all",
      "query": "dune",
      "expectedIds": [
        "b1"
      ]
    },
    {
      "name": "upper case query finds a title with lower case letters",
      "status": "all",
      "query": "DUNE",
      "expectedIds": [
        "b1"
      ]
    },
    {
      "name": "mixed case query",
      "status": "all",
      "query": "pRoJeCt hAiL",
      "expectedIds": [
        "b7"
      ]
    },
    {
      "name": "spaces around the query are ignored",
      "status": "all",
      "query": " Dune ",
      "expectedIds": [
        "b1"
      ]
    },
    {
      "name": "tab and newline around the query are ignored",
      "status": "all",
      "query": "\tdune\n",
      "expectedIds": [
        "b1"
      ]
    },
    {
      "name": "spaces inside the query are kept",
      "status": "all",
      "query": "the name",
      "expectedIds": [
        "b6"
      ]
    },
    {
      "name": "a part of a word matches",
      "status": "all",
      "query": "an",
      "expectedIds": [
        "b4",
        "b10"
      ]
    },
    {
      "name": "status and query are combined (done, the)",
      "status": "done",
      "query": "the",
      "expectedIds": [
        "b2",
        "b10"
      ]
    },
    {
      "name": "status and query are combined (all, the)",
      "status": "all",
      "query": "the",
      "expectedIds": [
        "b2",
        "b6",
        "b8",
        "b10"
      ]
    },
    {
      "name": "status and query with no common book gives an empty list",
      "status": "reading",
      "query": "dune",
      "expectedIds": []
    },
    {
      "name": "query without a match gives an empty list",
      "status": "all",
      "query": "xyz",
      "expectedIds": []
    },
    {
      "name": "the query searches the title only, not the author",
      "status": "all",
      "query": "Herbert",
      "expectedIds": []
    },
    {
      "name": "the query searches the title only, not the notes",
      "status": "all",
      "query": "train ride",
      "expectedIds": []
    },
    {
      "name": "the result keeps the order of the input",
      "status": "all",
      "query": "e",
      "expectedIds": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5",
        "b6",
        "b7",
        "b8",
        "b9",
        "b10"
      ]
    },
    {
      "name": "a query with spaces and a status",
      "status": "want-to-read",
      "query": "  THE  ",
      "expectedIds": [
        "b6",
        "b8"
      ]
    }
  ],
  "validateBook": [
    {
      "name": "valid title and author",
      "input": {
        "title": "Dune",
        "author": "Frank Herbert"
      },
      "expected": {}
    },
    {
      "name": "empty title",
      "input": {
        "title": "",
        "author": "Frank Herbert"
      },
      "expected": {
        "title": "Title is required"
      }
    },
    {
      "name": "empty author",
      "input": {
        "title": "Dune",
        "author": ""
      },
      "expected": {
        "author": "Author is required"
      }
    },
    {
      "name": "empty title and empty author",
      "input": {
        "title": "",
        "author": ""
      },
      "expected": {
        "title": "Title is required",
        "author": "Author is required"
      }
    },
    {
      "name": "title with only spaces",
      "input": {
        "title": "   ",
        "author": "Frank Herbert"
      },
      "expected": {
        "title": "Title is required"
      }
    },
    {
      "name": "author with only spaces",
      "input": {
        "title": "Dune",
        "author": "   "
      },
      "expected": {
        "author": "Author is required"
      }
    },
    {
      "name": "title with only a tab and a newline",
      "input": {
        "title": "\t\n",
        "author": "Frank Herbert"
      },
      "expected": {
        "title": "Title is required"
      }
    },
    {
      "name": "title and author with only spaces",
      "input": {
        "title": " ",
        "author": "  "
      },
      "expected": {
        "title": "Title is required",
        "author": "Author is required"
      }
    },
    {
      "name": "spaces around a valid title and author are fine",
      "input": {
        "title": "  Dune ",
        "author": " Frank Herbert "
      },
      "expected": {}
    }
  ]
}
