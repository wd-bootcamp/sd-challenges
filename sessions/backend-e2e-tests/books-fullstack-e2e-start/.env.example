# Copy this file to .env and fill in your values. Never commit .env.
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/reading-list?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/reading-list
MONGODB_URI=mongodb://127.0.0.1:27017/reading-list
PORT=3001

# E2E tests only. The database name MUST end with -e2e.
# Same cluster, other database.
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/reading-list-e2e?retryWrites=true&w=majority
# Local (CI, offline): mongodb://127.0.0.1:27017/reading-list-e2e
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/reading-list-e2e
