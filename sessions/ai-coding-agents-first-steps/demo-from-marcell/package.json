{
  "name": "bookshelf-agent-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Demo project for the Week 9 sessions about coding agents (Claude Code).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
